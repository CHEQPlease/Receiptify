<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="InOrMmUsage"
    >

    <!-- Same column weights as layout_p_purchased_items, at ~0.75x the item name size. -->
    <TextView
        android:id="@+id/tv_saving_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4.5"
        android:paddingRight="3mm"
        tools:text="CHEERS!"
        android:textSize="2.5mm" />

    <TextView
        android:id="@+id/tv_saving_qty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="2mm"
        tools:text="1"
        android:gravity="end"
        android:layout_weight="1"
        android:textSize="2.5mm" />

    <TextView
        android:id="@+id/tv_saving_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="-$20.00"
        android:gravity="end"
        android:layout_weight="2.5"
        android:textSize="2.5mm" />

</LinearLayout>
