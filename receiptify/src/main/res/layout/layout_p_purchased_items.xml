<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0.5mm"
    android:background="@android:color/white"
    android:theme="@style/ReceiptifyThemePOS"
    tools:ignore="InOrMmUsage"
    >

    <!-- Every line below shares the 4.5 / 1 / 2.5 column weights (and the
         quantity column's 2mm right margin) so savings line up under the
         item's quantity and price, and the details keep the item column width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.5"
            android:paddingRight="3mm"
            tools:text="Egg"
            android:textSize="3.3mm"
            tools:ignore="NestedWeights"
             />

        <TextView
            android:id="@+id/tv_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="2mm"
            tools:text="123"
            android:gravity="end"
            android:layout_weight="1"
            android:textSize="3mm" />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="$4000.00"
            android:textSize="3mm"
            android:gravity="end"
            android:layout_weight="2.5" />

    </LinearLayout>

    <!-- One layout_p_item_saving row per Item.savings entry. -->
    <LinearLayout
        android:id="@+id/container_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.5"
            tools:text="-- Cucumber\n-- Carrot"
            android:textSize="3mm"
            />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginRight="2mm"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2.5" />

    </LinearLayout>

</LinearLayout>
