<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="40mm"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0.5mm"
    android:background="@android:color/white"
    android:theme="@style/ReceiptifyThemeHandheld"
    tools:ignore="InOrMmUsage"
    >

    <!-- Every line below shares the 4 / 1 / 2.5 column weights (and the
         quantity column's end margin) so savings line up under the item's
         quantity and price, and the details keep the item column width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:paddingRight="3mm"
            tools:text="Water + Apple Pay"
            android:textStyle="bold"
            android:textSize="2.1mm"
            tools:ignore="NestedWeights"
            android:paddingEnd="3mm" />

        <TextView
            android:id="@+id/tv_qty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="1mm"
            tools:text="123"
            android:gravity="end"
            android:textStyle="bold"
            android:layout_weight="1"
            android:textSize="2.2mm"
            android:layout_marginRight="1.5mm" />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="$4000.00"
            android:textSize="2.2mm"
            android:gravity="end"
            android:textStyle="bold"
            android:layout_weight="2.5" />

    </LinearLayout>

    <!-- One layout_h_item_saving row per Item.savings entry. -->
    <LinearLayout
        android:id="@+id/container_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_item_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            tools:text="-- Deep Fried Salmon"
            android:textSize="1.9mm"
            android:textStyle="bold"
            />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="1mm"
            android:layout_marginRight="1.5mm"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="2.5" />

    </LinearLayout>

</LinearLayout>
